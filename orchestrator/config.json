{
  "tasks_file": "orchestrator/TASKS.md",
  "progress_file": "orchestrator/PROGRESS.md",
  "branch": "auto/tasks",
  "remote": "origin",
  "push": true,
  "backend": "opencode",
  "codex_bin": "codex",
  "opencode_bin": "opencode",
  "sandbox": "workspace-write",
  "gate_base": [],
  "checks": {
    "tools": ["python3 -m unittest discover -s tools/tests"],
    "core": ["bash ./gradlew :core:test --console=plain"],
    "data": ["bash ./gradlew :app:verifyDictionaryLicenses :core:test --console=plain"],
    "android": ["bash ./gradlew :app:compileDebugKotlin :app:lintDebug :app:compileDebugAndroidTestKotlin --console=plain"],
    "full": [
      "python3 -m unittest discover -s tools/tests",
      "python3 -m unittest discover -s orchestrator/tests",
      "bash ./gradlew :core:test :app:assembleDebug --console=plain"
    ],
    "release": ["bash ./gradlew :app:assembleRelease --console=plain"]
  },
  "task_timeout": 14400,
  "gate_timeout": 7200,
  "git_timeout": 120,
  "restart_retries": 3,
  "retry_delay": 30,
  "models": {
    "codex": {
      "light": "gpt-5.6-luna",
      "standard": "gpt-6.1-sol",
      "heavy": "gpt-6.1-sol"
    },
    "opencode": {
      "light": "opencode/glm-5.3-flash-free",
      "standard": "opencode/glm-5.3-flash-free#max",
      "heavy": "opencode/beam-free#max"
    }
  },
  "model_sets": {
    "codex": {
      "cheap": {
        "light": "gpt-5.6-luna",
        "standard": "gpt-5.6-luna",
        "heavy": "gpt-5.6-luna"
      }
    },
    "opencode": {
      "paid": {
        "light": "opencode/muse-ember-1.0#low",
        "standard": "opencode/deepseek-v4.1-flash#max",
        "heavy": "opencode/deepseek-v4-pro#max"
      },
      "cheap": {
        "light": "opencode/muse-ember-1.0#low",
        "standard": "opencode/deepseek-v4.1-flash#max",
        "heavy": "opencode/deepseek-v4.1-flash#max"
      }
    }
  },
  "semantic": {
    "codex": {
      "provider": "codex",
      "model": "gpt-6.1-sol",
      "cache": ".local/data01-cache"
    },
    "opencode": {
      "provider": "opencode",
      "model": "opencode/deepseek-v4.1-flash#max",
      "cache": ".local/data01-oc-cache"
    }
  },
  "efforts": {
    "light": "low",
    "standard": "medium",
    "heavy": "high"
  }
}
